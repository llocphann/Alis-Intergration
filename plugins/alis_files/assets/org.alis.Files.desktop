[Desktop Entry]
Name=Files
GenericName=File Manager
Comment=Alis native file manager
Exec=alis-files %U
Icon=org.alis.Files
Terminal=false
Type=Application
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=org.alis.Files
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=alis-files --new
