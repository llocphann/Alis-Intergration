{
  "id": "alis-intergration",
  "version": "1.0.0",
  "host": "Alis",
  "hostApi": 1,
  "session": "AlisSession.qml",
  "integrations": [
    "tlp",
    "thinkfan",
    "obsidian"
  ],
  "plugins": [
    {
      "id": "tlp",
      "name": "TLP",
      "icon": "battery_saver",
      "capabilities": [
        {
          "id": "power",
          "name": "Power",
          "settings": "tlp",
          "waffleSettings": "tlpWaffle"
        }
      ]
    },
    {
      "id": "thinkfan",
      "name": "Thinkfan",
      "icon": "mode_fan",
      "capabilities": [
        {
          "id": "cooling",
          "name": "Cooling",
          "settings": "thinkfan"
        }
      ]
    },
    {
      "id": "obsidian",
      "name": "Obsidian",
      "icon": "diamond",
      "capabilities": [
        {
          "id": "theming",
          "name": "Theming",
          "settings": "obsidian"
        },
        {
          "id": "quicknotes",
          "name": "Quicknotes",
          "settings": "obsidianTodo",
          "view": "quicknotes"
        },
        {
          "id": "todo",
          "name": "Todo",
          "settings": "obsidianTodo",
          "view": "todo"
        }
      ]
    }
  ],
  "settings": {
    "tlp": "modules/settings/TlpPowerSettings.qml",
    "obsidian": "modules/settings/ObsidianThemeSettings.qml",
    "obsidianTodo": "modules/settings/ObsidianTodoSettings.qml",
    "tlpRow": "modules/settings/TlpSettingRow.qml",
    "tlpWaffle": "modules/waffle/settings/WTlpPowerSettings.qml",
    "tlpWaffleRow": "modules/waffle/settings/WTlpSettingRow.qml",
    "thinkfan": "modules/settings/ThinkfanSettings.qml"
  },
  "backends": {
    "managedTodo": "services/ObsidianTodoBackend.qml",
    "dailyTodo": "services/DailyNoteTodoBackend.qml"
  },
  "derivedFrom": {
    "repository": "llocphann/Alis",
    "sourceSha": "6abf56328350b5871f1c626b2752d5e25d658539"
  },
  "uiDerivedFrom": {
    "repository": "llocphann/Alis",
    "sourceSha": "53af215df39bce6cf7fda5c226bbb37bb14f6b9e"
  },
  "name": "Alis-Intergration"
}
