{
  "id": "alis-intergration",
  "version": "1.0.0",
  "host": "Alis",
  "hostApi": 1,
  "session": "AlisSession.qml",
  "integrations": [
    "tlp",
    "thinkfan",
    "nexus",
    "spaced_repetition",
    "exercises_tracker"
  ],
  "plugins": [
    {
      "id": "tlp",
      "name": "TLP",
      "icon": "battery_saver",
      "capabilities": [
        {
          "id": "power",
          "name": "Power",
          "settings": "tlp",
          "waffleSettings": "tlpWaffle"
        }
      ]
    },
    {
      "id": "thinkfan",
      "name": "Thinkfan",
      "icon": "mode_fan",
      "capabilities": [
        {
          "id": "cooling",
          "name": "Cooling",
          "settings": "thinkfan"
        }
      ]
    },
    {
      "id": "nexus",
      "name": "Nexus",
      "icon": "hub",
      "capabilities": [
        {
          "id": "theming",
          "name": "Theming",
          "settings": "nexus"
        },
        {
          "id": "quicknotes",
          "name": "Quicknotes",
          "settings": "nexusTodo",
          "view": "quicknotes"
        },
        {
          "id": "todo",
          "name": "Todo",
          "settings": "nexusTodo",
          "view": "todo"
        }
      ]
    },
    {
      "id": "spaced_repetition",
      "name": "Spaced Repetition",
      "icon": "school",
      "capabilities": [
        {
          "id": "vocabulary",
          "name": "Vocabulary & Cards",
          "settings": "spacedRepetition"
        }
      ]
    },
    {
      "id": "exercises_tracker",
      "name": "Exercises Tracker",
      "icon": "fitness_center",
      "capabilities": [
        {
          "id": "workouts",
          "name": "Workouts & Body Tracker",
          "settings": "exercisesTracker"
        }
      ]
    }
  ],
  "settings": {
    "tlp": "modules/settings/TlpPowerSettings.qml",
    "nexus": "modules/settings/NexusThemeSettings.qml",
    "nexusTodo": "modules/settings/NexusTodoSettings.qml",
    "tlpRow": "modules/settings/TlpSettingRow.qml",
    "tlpWaffle": "modules/waffle/settings/WTlpPowerSettings.qml",
    "tlpWaffleRow": "modules/waffle/settings/WTlpSettingRow.qml",
    "thinkfan": "modules/settings/ThinkfanSettings.qml",
    "spacedRepetition": "modules/settings/DashboardSpacedRepetitionSettings.qml",
    "exercisesTracker": "modules/settings/DashboardExercisesTrackerSettings.qml"
  },
  "backends": {
    "managedTodo": "services/NexusTodoBackend.qml",
    "dailyTodo": "services/DailyNoteTodoBackend.qml"
  },
  "derivedFrom": {
    "repository": "llocphann/Alis",
    "sourceSha": "6abf56328350b5871f1c626b2752d5e25d658539"
  },
  "uiDerivedFrom": {
    "repository": "llocphann/Alis",
    "sourceSha": "53af215df39bce6cf7fda5c226bbb37bb14f6b9e"
  },
  "name": "Alis-Intergration"
}
