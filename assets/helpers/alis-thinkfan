#!/bin/sh

service_name=thinkfan.service
fan_path=/proc/acpi/ibm/fan
fan_control_path=/sys/module/thinkpad_acpi/parameters/fan_control

usage() {
    printf '%s\n' 'Usage: alis-thinkfan --status | --apply managed | --apply firmware | --set-level auto|1..7' >&2
    exit 2
}

json_bool() {
    [ "${1:-0}" -eq 1 ] && printf true || printf false
}

json_string() {
    printf '"%s"' "$(printf '%s' "${1:-}" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

find_thinkfan() {
    command -v thinkfan 2>/dev/null || true
}

service_installed() {
    systemctl cat "$service_name" >/dev/null 2>&1
}

read_fan_value() {
    key=$1
    [ -r "$fan_path" ] || return 0
    sed -n "s/^${key}:[[:space:]]*//p" "$fan_path" | head -n 1
}

direct_control_available() {
    [ -r "$fan_path" ] || return 1
    [ -r "$fan_control_path" ] || return 1
    control=$(cat "$fan_control_path" 2>/dev/null || true)
    case "$control" in
        Y|y|1) return 0 ;;
        *) return 1 ;;
    esac
}

status() {
    binary=$(find_thinkfan)
    available=0
    installed=0
    active=0
    enabled=0
    direct=0
    reason=""
    rpm=""
    level=""
    profile=firmware
    config=""

    [ -n "$binary" ] && available=1
    direct_control_available && direct=1
    if service_installed; then
        installed=1
        systemctl is-active --quiet "$service_name" && active=1
        systemctl is-enabled --quiet "$service_name" && enabled=1
    fi

    rpm=$(read_fan_value speed)
    level=$(read_fan_value level)
    case "$rpm" in ''|*[!0-9]*) rpm="" ;; esac

    if [ "$active" -eq 1 ]; then
        profile=managed
    elif [ "$direct" -eq 1 ]; then
        case "$level" in
            1|2|3|4|5|6|7) profile=manual ;;
        esac
    fi

    if [ -r /etc/thinkfan.yaml ]; then
        config=/etc/thinkfan.yaml
    elif [ -r /etc/thinkfan.conf ]; then
        config=/etc/thinkfan.conf
    fi

    if [ "$available" -eq 0 ]; then
        reason=thinkfan-unavailable
    elif [ "$installed" -eq 0 ]; then
        reason=service-unavailable
    elif [ "$active" -eq 0 ]; then
        reason=firmware-control
    fi

    printf '{"schema":1,"available":%s,"serviceInstalled":%s,"active":%s,"enabled":%s,"fanLevelControlSupported":true,"directControlAvailable":%s,"profile":' \
        "$(json_bool "$available")" "$(json_bool "$installed")" \
        "$(json_bool "$active")" "$(json_bool "$enabled")" "$(json_bool "$direct")"
    json_string "$profile"
    printf ',"fanRpm":%s,"fanLevel":' "${rpm:-null}"
    json_string "$level"
    printf ',"configPath":'
    json_string "$config"
    printf ',"reason":'
    json_string "$reason"
    printf '}\n'
}

require_root() {
    [ "$(id -u)" -eq 0 ] || {
        printf '%s\n' 'alis-thinkfan: privileged fan control requires polkit/root' >&2
        exit 77
    }
}

apply_profile() {
    profile=$1
    require_root

    service_installed || {
        printf '%s\n' 'alis-thinkfan: thinkfan.service is not installed' >&2
        exit 69
    }

    case "$profile" in
        managed)
            [ -n "$(find_thinkfan)" ] || {
                printf '%s\n' 'alis-thinkfan: thinkfan executable is unavailable' >&2
                exit 69
            }
            systemctl enable --now "$service_name" || exit $?
            systemctl is-active --quiet "$service_name" || {
                printf '%s\n' 'alis-thinkfan: service did not become active' >&2
                exit 70
            }
            systemctl is-enabled --quiet "$service_name" || {
                printf '%s\n' 'alis-thinkfan: service did not become enabled' >&2
                exit 70
            }
            ;;
        firmware)
            systemctl disable --now "$service_name" || exit $?
            if systemctl is-active --quiet "$service_name"; then
                printf '%s\n' 'alis-thinkfan: service remained active after disable' >&2
                exit 70
            fi
            if systemctl is-enabled --quiet "$service_name"; then
                printf '%s\n' 'alis-thinkfan: service remained enabled after disable' >&2
                exit 70
            fi
            # If direct ThinkPad ACPI control is available, always return the
            # hardware to automatic control when leaving a managed/manual mode.
            if direct_control_available; then
                printf '%s\n' 'level auto' > "$fan_path" || {
                    printf '%s\n' 'alis-thinkfan: failed to restore automatic fan control' >&2
                    exit 70
                }
            fi
            ;;
        *) usage ;;
    esac

    status
}

set_fan_level() {
    level=$1
    case "$level" in
        auto|1|2|3|4|5|6|7) ;;
        *) usage ;;
    esac

    require_root
    direct_control_available || {
        printf '%s\n' 'alis-thinkfan: direct ThinkPad fan control is unavailable (requires thinkpad_acpi fan_control=1)' >&2
        exit 69
    }

    if service_installed && systemctl is-active --quiet "$service_name"; then
        printf '%s\n' 'alis-thinkfan: stop ThinkFan managed control before setting a fixed fan level' >&2
        exit 70
    fi

    printf 'level %s\n' "$level" > "$fan_path" || {
        printf '%s\n' 'alis-thinkfan: failed to write the requested fan level' >&2
        exit 70
    }

    status
}

case "${1:-}" in
    --status)
        [ "$#" -eq 1 ] || usage
        status
        ;;
    --apply)
        [ "$#" -eq 2 ] || usage
        apply_profile "$2"
        ;;
    --set-level)
        [ "$#" -eq 2 ] || usage
        set_fan_level "$2"
        ;;
    *) usage ;;
esac
